# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE (VERCEL DEPLOYMENT GUIDE)
# ==============================================================================
# In Vercel Project Dashboard -> Settings -> Environment Variables:
# 1. NEXT_PUBLIC_API_URL: Your backend service URL on Render (e.g. https://your-backend.onrender.com)
# 2. NEXT_PUBLIC_SITE_URL: Your frontend domain on Vercel (e.g. https://your-frontend.vercel.app)
# 3. NEXT_PUBLIC_APP_NAME: WorkSphere — Tech Career Infrastructure
# ==============================================================================

NEXT_PUBLIC_API_URL=https://jobseeker-backend-u7lc.onrender.com
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app
NEXT_PUBLIC_APP_NAME=WorkSphere — Tech Career Infrastructure
NODE_ENV=production
